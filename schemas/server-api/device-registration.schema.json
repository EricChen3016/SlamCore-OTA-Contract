{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slamcore.local/schemas/server-api/device-registration.schema.json",
  "title": "DeviceRegistration",
  "description": "Registers Agent and Updater metadata. capabilities is an Agent-owned replacement snapshot; absent or empty means that no optional capability is advertised.",
  "type": "object",
  "required": [
    "contractVersion",
    "deviceId",
    "machineName",
    "agentVersion",
    "updaterEndpoint",
    "platform",
    "currentReleaseVersion"
  ],
  "properties": {
    "contractVersion": {"const": "2.0"},
    "deviceId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "machineName": {"type": "string", "minLength": 1},
    "agentVersion": {"type": "string"},
    "updaterEndpoint": {"type": "string", "format": "uri", "pattern": "^http://"},
    "platform": {"type": "string"},
    "currentReleaseVersion": {"type": "string"},
    "capabilities": {
      "description": "Complete capability set for this registration. The recognized explicit rollback token is explicit-rollback-v1. Unknown tokens are retained or ignored and never imply rollback support.",
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": true
}
