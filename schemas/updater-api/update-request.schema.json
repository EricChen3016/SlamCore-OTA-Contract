{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slamcore.local/schemas/updater-api/update-request.schema.json",
  "title": "UpdateRequest",
  "type": "object",
  "required": ["contractVersion", "jobId", "targetVersion", "packageUrl", "packageSha256", "platform"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "jobId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "targetVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "packageUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platform": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  },
  "additionalProperties": true
}
